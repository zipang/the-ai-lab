#!/bin/bash
set -euo pipefail

# Args: audio_file [model] [input_lang] [output_lang] [vad_model]
AUDIO_FILE="${1:-}"

# Load environment variables (Do not source .env to preserve resolved path if passed)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

MODEL="${2:-${WHISPER_MODEL:-base}}" # MODEL can be a short name or the full model path
INPUT_LANG="${3:-${WHISPER_INPUT:-auto}}"
OUTPUT_LANG="${4:-${WHISPER_OUTPUT:-${INPUT_LANG}}}"
VAD_MODEL="${5:-${WHISPER_VAD_MODEL}:-}" # VAD_MODEL can be a short name or the full path (Arg 5 or Env Var)

# Check required args
[[ -z "$AUDIO_FILE" ]] && { echo "Error: Audio file not provided." >&2; exit 1; }
[[ -f "$AUDIO_FILE" ]] || { echo "Error: Audio file not found: $AUDIO_FILE" >&2; exit 1; }

# Paths & checks using env vars
# WHISPER_CLI is expected to be provided by the environment or .env
[[ -z "${WHISPER_CLI:-}" ]] && { echo "Error: WHISPER_CLI is not set." >&2; exit 1; }
[[ -f "$WHISPER_CLI" ]] || { echo "Error: whisper-cli not found at $WHISPER_CLI" >&2; exit 1; }

WHISPER_MODELS_PATH="${WHISPER_MODELS_PATH:-$BASE_DIR/whisper.cpp/models}"

# Resolve main model path: If $MODEL contains /, use it directly; otherwise, use ggml- prefix.
if [[ "$MODEL" =~ [/\] ]]; then
    MODEL_FILE="$MODEL"
else
    MODEL_FILE="${WHISPER_MODELS_PATH}/ggml-$MODEL.bin"
fi
[[ -f "$MODEL_FILE" ]] || { echo "Error: Model not found at $MODEL_FILE" >&2; exit 1; }

# Translate flag
TR_FLAG=""
[[ "$OUTPUT_LANG" == "en" && "$INPUT_LANG" != "en" ]] && TR_FLAG="-tr"

# Whisper arguments
# Added -np flag to suppress all output except transcription
WHISPER_ARGS=(-m "$MODEL_FILE" -f "$AUDIO_FILE" -nt -l "$INPUT_LANG" -np)
[[ -n "$TR_FLAG" ]] && WHISPER_ARGS+=("$TR_FLAG")

# Optional VAD support
if [[ -n "$VAD_MODEL" ]]; then
    if [[ -f "$VAD_MODEL" ]]; then
        WHISPER_ARGS+=(--vad -vm "$VAD_MODEL")
    fi

    # Extend the short name given to the full model path
    VAD_MODEL="${WHISPER_MODELS_PATH}/ggml-${VAD_MODEL}.bin"

    if [[ -f "$VAD_MODEL" ]]; then
        WHISPER_ARGS+=(--vad -vm "$VAD_MODEL")
    fi
fi

# Execute whisper-cli
echo "$WHISPER_CLI ${WHISPER_ARGS[@]}"
"$WHISPER_CLI" "${WHISPER_ARGS[@]}" 2>/tmp/whisper_error.log || {
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
        cat /tmp/whisper_error.log >&2
        exit 1
    fi
}
