#!/bin/bash
# Accepts input_file and output_file as arguments
INPUT_FILE="$1"
OUTPUT_FILE="$2"

# Check if both arguments are provided
if [ -z "$INPUT_FILE" ] || [ -z "$OUTPUT_FILE" ]; then
    echo "Usage: $0 <input_file> <output_file>"
    exit 1
fi

# Check if input file exists
if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: Input file '$INPUT_FILE' not found."
    exit 1
fi

# Get the volume multiplier using sox stat
multiplier=$(sox "$INPUT_FILE" -n stat -v 2>&1)

# Apply silence trimming and volume gain
sox "$INPUT_FILE" "$OUTPUT_FILE" silence 1 1.0 0.1% 1 1.0 0.1% -v $multiplier

echo "Processed '$INPUT_FILE' to '$OUTPUT_FILE'"
